--- !u!114 &1470053649
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1470053648}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3142328ce6992ba47b93a300cc2864ac, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPC_Dialogue
  dialoguePanel: {fileID: 2520466111762878359}
  dialogueText: {fileID: 2520466111762878358}
  dialogue:
  - 'Greek builders created three famous column styles. They supported the roofs
    of temples and public buildings while also making them beautiful. '
  - 'The Doric column is the simplest style, with a plain top and a strong appearance. '
  - 'The Ionic column is easy to recognize because of the curled shapes, called volutes,
    at the top. '
  - ' The Corinthian column is the most decorative, with carved leaves that resemble
    the acanthus plant. '
  - ' Did you know?  Architects still use these column styles on important buildings
    today! '
  contButton: {fileID: 2520466111762878357}
  wordSpeed: 0.05

    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 14
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 3
    m_MaxSize: 64
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: 'Greek temples weren''t places where people gathered every day. They were
    built to honor the gods and protect their statues inside, while ceremonies often
    took place outside!

    Most temples were built from strong materials such as
    marble or limestone so they would last for centuries. Their rectangular shape,
    tall columns, and triangular roof made them easy to recognize. Artists also decorated
    temples with carved sculptures called reliefs and long decorative bands called
    friezes, which often showed scenes from mythology or important events.

'

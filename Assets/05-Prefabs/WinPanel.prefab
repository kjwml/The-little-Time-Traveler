  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "The Dipylon Amphora was made around 760\u2013750 BC, and is now in the
    National Archaeological Museum in Athens! Discovered at the Dipylon cemetery,
    no one knows who made this vessel from the Geometric period. Instead, the call
    then the Diplyon Master! \r\n\r\nIt\u2019s filled entirely in ornamental and
    geometric patters as well as human figures and animal motifs, painted using the
    black-figure technique. Twice as tall as it is wide, with a neck that is half
    the height of its body, this vase is a funerary vessel. \r\nThe Diplyon Amphora
    signifies the passing of a noble woman, showing the procession of her funeral
    with her mourning friends and family.\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 6115019ff07260a42970475c9646e3f1, type: 2}
  m_sharedMaterial: {fileID: -5386974999803709113, guid: 6115019ff07260a42970475c9646e3f1, type: 2}
